{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "sleepApplication": false,
    "cron": {
      "runDailyPicks": {
        "schedule": "0 6 * * *",
        "command": "wget -O- http://localhost:3005/api/run-daily-picks"
      },
      "checkResolutions": {
        "schedule": "0 * * * *",
        "command": "wget -O- http://localhost:3005/api/check-resolutions"
      }
    }
  }
}
