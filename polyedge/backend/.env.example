# PolyEdge Backend Environment Variables
# Copy to .env and fill in your values

EXPO_PUBLIC_SUPABASE_URL=https://utbkvjgatqiibfkcpugc.supabase.co
EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Polymarket API endpoints (defaults to gamma-api.polymarket.com)
